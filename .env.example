NOUS_API_KEY=your-nous-api-key
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
NOUS_MODEL=Hermes-4-70B
KIMI_API_KEY=your-moonshot-api-key
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6
DATA_DIR=data/worlds
CHRONICLON_DIR=data/chroniclon
HOST=127.0.0.1
PORT=8003
APP_ENV=development
# Required in production. Docker Compose forwards this into the SPA build as a
# shared demo token; do not treat it as user-specific auth.
GENESIS_API_KEY=
ADMIN_SESSION_COOKIE=genesis_admin
ADMIN_SESSION_TTL_SECONDS=86400
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_PROXY_IPS=127.0.0.1,::1
MAX_WORLDS=100
IMAGE_API_KEY=your-together-ai-key
IMAGE_API_URL=https://api.together.xyz/v1
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
TTS_PROVIDER=          # elevenlabs | 60db | openai (blank = no narration)
ELEVENLABS_API_KEY=
# 60db.ai TTS — https://api.60db.ai. Voice ids are account-specific UUIDs
# (GET https://api.60db.ai/myvoices); leave the SIXTYDB_VOICE_* vars unset to use
# the account system-default voice.
SIXTYDB_API_KEY=
SIXTYDB_VOICE_NARRATOR=
SIXTYDB_VOICE_WARRIOR=
SIXTYDB_VOICE_SCHEMER=
SIXTYDB_VOICE_SCHOLAR=
SIXTYDB_VOICE_MYSTIC=
OPENAI_API_KEY=
